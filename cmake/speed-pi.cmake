function(configure_speed_pi systick_hz)
    set(rates 100 500)
    if(systick_hz EQUAL 1000)
        list(APPEND rates 1000)
    endif()
    set(SPEED_PI_HZ ${systick_hz} CACHE STRING "Outer speed PI frequency (Hz); the slow service stays at 100 Hz")
    set_property(CACHE SPEED_PI_HZ PROPERTY STRINGS ${rates})
    if(NOT SPEED_PI_HZ IN_LIST rates)
        message(FATAL_ERROR "SPEED_PI_HZ must be one of ${rates} (board SysTick: ${systick_hz} Hz)")
    endif()
    add_compile_definitions($<$<COMPILE_LANGUAGE:CXX>:LIBECU_SPEED_PI_HZ=${SPEED_PI_HZ}>)
endfunction()
